# Schachtblick – Webserver-Einstellungen (Apache / IONOS)
AddType application/manifest+json .webmanifest
AddType text/javascript .js .mjs
AddDefaultCharset utf-8
<IfModule mod_headers.c>
  # Programmdateien bei jedem Laden beim Server prüfen (304 = unverändert, sehr schnell),
  # damit nach einem Update nie alte und neue Dateien gemischt werden
  <FilesMatch "\.(html|js|mjs|css|webmanifest|json|xml)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
  Header always set Permissions-Policy "camera=(self), geolocation=(self)"
</IfModule>
# HTTPS erzwingen (Kamera, GPS und Offline-Funktion setzen HTTPS voraus)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>
